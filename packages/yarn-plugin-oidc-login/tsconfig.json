{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true
  },
  "include": ["sources/**/*.ts"]
}
