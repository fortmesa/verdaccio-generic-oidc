{
  "name": "@fortmesa/verdaccio-generic-oidc",
  "version": "1.1.1",
  "description": "Generic OpenID Connect authentication plugin for Verdaccio, with configurable groups/roles mapping and pluggable session storage (Redis, filesystem, or DynamoDB). Fork of verdaccio-openid-connect.",
  "license": "MIT",
  "repository": "fortmesa/verdaccio-generic-oidc",
  "homepage": "https://github.com/fortmesa/verdaccio-generic-oidc#readme",
  "keywords": [
    "verdaccio",
    "verdaccio-plugin",
    "npm-registry",
    "oidc",
    "openid-connect",
    "oauth2",
    "sso"
  ],
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@verdaccio/core": "8.3.3",
    "@verdaccio/types": "^13.0.6",
    "express": "4.22.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "body-parser": "~1.20.5",
    "jsonwebtoken": "^9.0.3",
    "openid-client": "^5.7.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "ioredis": "^5.4.1 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
