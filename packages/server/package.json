{
  "name": "@fortmesa/verdaccio-generic-oidc",
  "version": "1.0.3",
  "description": "Generic OpenID Connect authentication plugin for Verdaccio, with configurable groups/roles mapping and pluggable session storage (Redis, filesystem, or DynamoDB). Fork of verdaccio-openid-connect.",
  "license": "MIT",
  "repository": "fortmesa/verdaccio-generic-oidc",
  "homepage": "https://github.com/fortmesa/verdaccio-generic-oidc#readme",
  "keywords": [
    "verdaccio",
    "verdaccio-plugin",
    "npm-registry",
    "oidc",
    "openid-connect",
    "oauth2",
    "sso"
  ],
  "main": "lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.2",
    "@types/express": "^4.17.11",
    "@types/generic-pool": "^3.1.9",
    "@types/jsonwebtoken": "9.0.7",
    "@types/ms": "^0.7.31",
    "@types/node": "^22.5.5",
    "@verdaccio/types": "^10.8.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "async-retry": "^1.3.1",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "nanoid": "^3.1.20",
    "openid-client": "^5.7.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "generic-pool": "^3.7.1",
    "ioredis": "^5.4.1"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "generic-pool": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
